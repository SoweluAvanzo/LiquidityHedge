# Copy to .env (same directory) and fill in. NEVER commit .env.
# Secrets live only here and in the host's secret store.

# Public domain Caddy should serve + obtain TLS certificates for.
SITE_DOMAIN=app.example.com

# Server-side Solana RPC (Helius or similar). Never exposed to browsers.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Optional browser RPC for wallet connections (public/free endpoint).
NEXT_PUBLIC_RPC_URL=

# Market data.
BIRDEYE_API_KEY=your_birdeye_key

# Hedge module (leave HEDGE_TREASURY_ADDRESS empty to keep hedging disabled —
# the Monitor module works standalone; endpoints return 503).
HEDGE_TREASURY_ADDRESS=
HEDGE_INITIAL_RESERVES_USDC=0
HEDGE_PER_BUYER_CAP_USDC=0

# Premium floor in µUSDC (50000 = $0.05, docs/03 §3.3).
HEDGE_PREMIUM_FLOOR_USDC=50000

# Data export by email (docker compose --profile reports up -d).
# Sender domain must be verified in Resend. Interval 48h = every 2 days.
RESEND_API_KEY=
REPORT_FROM=LH Reports <reports@nortadesyco.xyz>
REPORT_TO=sowelu.avanzo@nortadesyco.xyz,sowelu94@gmail.com
REPORT_INTERVAL_HOURS=48

# Snapshot collector universe: every Orca pool with at least this much 24h
# volume (USD). Lower = richer dataset, more RPC. 0 pools below it.
MIN_POOL_VOLUME_USD=10000
MAX_TRACKED_POOLS=400

# PostgreSQL (internal network only — never published on the host).
# Generate strong values, e.g.: openssl rand -base64 32
POSTGRES_USER=lh_admin
POSTGRES_PASSWORD=
POSTGRES_DB=lh
LH_WRITER_PASSWORD=
LH_READER_PASSWORD=

# Backups (nightly pg_dump into the lh_backups volume; ship offsite per RB-6)
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# Hedging money path (profile: hedge). The hot wallet key file is mounted
# read-only into the payout executor ONLY — never into the web container.
# Keep PAYOUT_DRY_RUN=1 until the devnet rehearsal has passed on mainnet config.
HOT_WALLET_KEYPAIR_PATH=./hot-wallet.json
HOT_WALLET_FLOAT_CAP_USDC=2000000000
PAYOUT_LOOP_SECONDS=120
PAYOUT_DRY_RUN=1
SETTLEMENT_INTERVAL_SECONDS=60
# B2: the dataset revenue wallet MUST differ from HEDGE_TREASURY_ADDRESS.
DATA_REVENUE_WALLET=
