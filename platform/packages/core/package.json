{
  "name": "@lh/core",
  "version": "0.1.0",
  "private": true,
  "description": "Liquidity Hedge economic core — pricing, payoff, pool accounting, certificate lifecycle, market-data adapters. Extracted from the audited prototype (lh-protocol/protocol-src).",
  "main": "src/index.ts",
  "scripts": {
    "test": "ts-mocha 'tests/**/*.test.ts' --timeout 60000 --recursive",
    "test:legacy": "ts-mocha 'tests/unit/**/*.test.ts' 'tests/integration/**/*.test.ts' 'tests/scenarios/**/*.test.ts' 'tests/invariants/**/*.test.ts' --timeout 60000 --recursive",
    "test:differential": "ts-mocha 'tests/differential/**/*.test.ts' --timeout 120000 --recursive",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.0",
    "@solana/web3.js": "^1.95.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "chai": "^4.3.0",
    "mocha": "^10.2.0",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  }
}
